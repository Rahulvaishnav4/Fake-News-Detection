# Fake News Detection System - Configuration
# Copy this file to .env and adjust variables as needed

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Optional: Google Custom Search API (If omitted, system uses official Google News RSS feed)
# Get credentials from: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional: Google Fact Check Tools API Key
# https://toolbox.google.com/factcheck/apis
GOOGLE_FACT_CHECK_API_KEY=

# Optional: NewsAPI Key (Alternative fallback)
# https://newsapi.org/
NEWS_API_KEY=

# Database configuration
DATABASE_PATH=backend/fake_news.db

# Cache TTL in seconds (default: 900 = 15 minutes)
CACHE_TTL_SECONDS=900
